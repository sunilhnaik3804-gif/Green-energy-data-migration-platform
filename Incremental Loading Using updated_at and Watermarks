CREATE TABLE IF NOT EXISTS public.etl_watermarks (
    source_system VARCHAR(20) PRIMARY KEY,
    last_updated_timestamp TIMESTAMPTZ,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Initialize both source watermarks.
-- NULL means the first run has no saved watermark.
INSERT INTO public.etl_watermarks (
    source_system,
    last_updated_timestamp
)
VALUES
    ('ORACLE', NULL),
    ('MYSQL', NULL)
ON CONFLICT (source_system) DO NOTHING;
